generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  USER
  HOST
  ADMIN
}

enum HotelStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  role         Role     @default(USER)
  isBanned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  hotels       Hotel[]
  bookings     Booking[]
  wishlists    Wishlist[]
  coupons      Coupon[]
}

model Hotel {
  id            String          @id @default(uuid())
  hostId        String
  host          User            @relation(fields: [hostId], references: [id])
  name          String
  description   String?
  address       String
  city          String
  country       String
  starRating    Float           @default(0)
  status        HotelStatus     @default(PENDING)
  searchVector  Unsupported("vector")?
  coverImage    String?
  images        String[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  rooms         Room[]
  hotelAmenities HotelAmenity[]
  wishlists     Wishlist[]
  pricingRules  PricingRule[]
  cancellationPolicies CancellationPolicy[]
}

model Room {
  id            String         @id @default(uuid())
  hotelId       String
  hotel         Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name          String
  type          String
  basePrice     Float
  capacity      Int
  quantity      Int
  searchVector  Unsupported("vector")?
  imageUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  roomAmenities RoomAmenity[]
  bookings      Booking[]
}

model Amenity {
  id             String          @id @default(uuid())
  name           String          @unique
  icon           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  hotelAmenities HotelAmenity[]
  roomAmenities  RoomAmenity[]
}

model HotelAmenity {
  hotelId   String
  amenityId String
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([hotelId, amenityId])
}

model RoomAmenity {
  roomId    String
  amenityId String
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  CHECKED_IN
  CHECKED_OUT
}

model Booking {
  id            String        @id @default(uuid())
  userId        String
  roomId        String
  user          User          @relation(fields: [userId], references: [id])
  room          Room          @relation(fields: [roomId], references: [id])
  checkIn       DateTime
  checkOut      DateTime
  guests        Int
  roomQuantity  Int           @default(1)
  totalPrice    Float
  status        BookingStatus @default(PENDING_PAYMENT)
  paymentMethod String?
  refundAmount  Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PricingRule {
  id         String   @id @default(uuid())
  hotelId    String
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name       String
  multiplier Float?
  flatFee    Float?
  startDate  DateTime?
  endDate    DateTime?
  dayOfWeek  Int?
  createdAt  DateTime @default(now())
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  amount        Float
  maxDiscount   Float?
  minSpend      Float?
  quantity      Int?
  hostId        String?
  host          User?        @relation(fields: [hostId], references: [id])
  expiryDate    DateTime?
  createdAt     DateTime     @default(now())
}

model Wishlist {
  userId  String
  hotelId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([userId, hotelId])
}

model CancellationPolicy {
  id                  String   @id @default(uuid())
  hotelId             String
  hotel               Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  daysBeforeCheckIn   Int
  penaltyPercentage   Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
